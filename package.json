{
  "name": "glass-notes",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-dependency-compat.mjs",
    "validation:test": "node --test scripts/validation-*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "audit:repo": "node scripts/audit-repository.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "brand:build": "node scripts/trace-selected-brand.mjs && node scripts/compare-brand-reference.mjs && node scripts/build-brand.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "start": "node scripts/expo.mjs start --web",
    "web": "node scripts/expo.mjs start --web",
    "build:web": "node scripts/expo.mjs export --platform web",
    "release:web": "npm run build:web && node scripts/package-web.mjs",
    "preview": "node scripts/serve.mjs",
    "preview:lan": "node scripts/serve.mjs --lan",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:test": "node scripts/desktop.mjs test",
    "desktop:check": "node scripts/desktop.mjs check",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/domain/search/*.test.ts src/domain/discovery/*.test.ts src/domain/bottles/*.test.ts src/domain/guided/*.test.ts src/domain/context/*.test.ts src/domain/ingredients/*.test.ts src/domain/private-recipes/*.test.ts src/domain/backup/*.test.ts src/domain/making/*.test.ts src/domain/shopping/*.test.ts src/domain/taste/*.test.ts src/domain/order/*.test.ts src/i18n/*.test.ts src/content/*.test.ts src/content/localization/*.test.ts src/platform/*.test.ts scripts/*.test.mjs",
    "browser:install": "node scripts/browser.mjs install",
    "test:e2e": "node scripts/browser.mjs test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@gsap/react": "^2.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tauri-apps/api": "2.11.1",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.18",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.20",
    "gsap": "^3.15.0",
    "pinyin-pro": "3.29.3",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.4.1",
    "@types/react": "~19.2.2",
    "sharp": "0.35.5",
    "tsx": "4.23.13",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "uuid": "11.1.1",
    "@expo/cli": {
      "zod": "4.6.6"
    },
    "glob@^13.0.0": "14.0.6",
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    }
  }
}
