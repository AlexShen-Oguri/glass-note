{
  "name": "glass-notes",
  "version": "0.1.9",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-dependency-compat.mjs",
    "workflow:test": "node --test scripts/workflow-*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "audit:repo": "node scripts/audit-repository.mjs",
    "brand:build": "node scripts/trace-selected-brand.mjs && node scripts/compare-brand-reference.mjs && node scripts/build-brand.mjs",
    "brand:check": "node scripts/check-brand.mjs",
    "start": "node scripts/expo.mjs start",
    "web": "node scripts/expo.mjs start --web",
    "build:web": "node scripts/expo.mjs export --platform web",
    "release:web": "npm run build:web && node scripts/package-web.mjs",
    "build:ios": "node scripts/expo.mjs export --platform ios --output-dir dist-ios",
    "preview": "node scripts/serve.mjs",
    "preview:lan": "node scripts/serve.mjs --lan",
    "native:lan": "node scripts/expo.mjs start --lan --go --port 8081",
    "native:tunnel": "node scripts/expo.mjs start --tunnel --go --port 8081",
    "native:phone": "node scripts/native-phone.mjs",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:test": "node scripts/desktop.mjs test",
    "desktop:check": "node scripts/desktop.mjs check",
    "mobile:preflight": "node scripts/mobile-preflight.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/domain/search/*.test.ts src/domain/discovery/*.test.ts src/domain/bottles/*.test.ts src/domain/guided/*.test.ts src/domain/context/*.test.ts src/domain/ingredients/*.test.ts src/domain/private-recipes/*.test.ts src/domain/backup/*.test.ts src/domain/making/*.test.ts src/domain/taste/*.test.ts src/domain/order/*.test.ts src/i18n/*.test.ts src/content/*.test.ts src/content/localization/*.test.ts src/platform/*.test.ts scripts/*.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@tauri-apps/api": "2.11.1",
    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-sharing": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "pinyin-pro": "3.29.3",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.4.1",
    "@types/react": "~19.2.2",
    "qrcode": "1.5.4",
    "sharp": "0.35.4",
    "tsx": "4.23.13",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  }
}
